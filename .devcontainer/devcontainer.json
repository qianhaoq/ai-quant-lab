{
  "name": "ai-quant-lab",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/workspace",
  "overrideCommand": true,
  "forwardPorts": [3000, 8000, 5432],
  "onCreateCommand": "corepack enable",
  "updateContentCommand": "pnpm install --frozen-lockfile && pnpm api:install",
  "postCreateCommand": "node --version && pnpm --version && python3 --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.copilot"
      ]
    }
  }
}
