# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://web:3000
MARKET_DATA_PROVIDER=sample
BROKER_PROVIDER=internal_sandbox
BROKER_MODE=sandbox
ENABLE_LIVE_TRADING=false
MAX_ORDER_NOTIONAL=25000
MAX_ORDER_QUANTITY=100
ALLOWED_TRADE_SYMBOLS=SPY,QQQ,AAPL

# Optional providers. The app runs without these.
OPENAI_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
POLYGON_API_KEY=

# Local docker compose database reserved for future persistence.
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant
POSTGRES_DB=quant_lab

# Linear queue runner. Keep real values in local shell, CI secrets, or runner secret storage.
LINEAR_API_KEY=
RUNNER_REPO=qianhaoq/ai-quant-lab
RUNNER_BASE_BRANCH=main
RUNNER_TEAM_KEY=ONE
RUNNER_READY_STATE="待 Agent 处理"
RUNNER_RUNNING_STATE="Agent 执行中"
RUNNER_AI_REVIEW_STATE="AI 评审"
RUNNER_HUMAN_REVIEW_STATE="人工评审"
RUNNER_FAILURE_STATE="待 Agent 处理"
RUNNER_REQUIRED_LABEL=ai-agent-ready
RUNNER_ALLOW_TRADING_RISK=false
RUNNER_SELECTION_LIMIT=20
RUNNER_MAX_ATTEMPTS=2
RUNNER_WORKTREES_DIR=../.runner-worktrees
RUNNER_SETUP_COMMANDS="pnpm install --frozen-lockfile|pnpm api:install"
RUNNER_TEST_COMMANDS="pnpm api:test|pnpm lint|pnpm typecheck|pnpm test|pnpm build|pnpm test:e2e"
RUNNER_CODEX_COMMAND=codex
RUNNER_CODEX_ARGS="exec --json --sandbox workspace-write -"
