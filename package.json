{
  "name": "ai-quant-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:web": "pnpm --filter @ai-quant-lab/web dev",
    "build": "pnpm --filter @ai-quant-lab/web build",
    "lint": "pnpm --filter @ai-quant-lab/web lint",
    "test": "pnpm --filter @ai-quant-lab/web test",
    "test:e2e": "pnpm --filter @ai-quant-lab/web test:e2e",
    "typecheck": "pnpm --filter @ai-quant-lab/web typecheck",
    "api:install": "cd apps/api && python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev]'",
    "api:dev": "cd apps/api && .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "api:test": "cd apps/api && .venv/bin/python -m pytest"
  }
}
